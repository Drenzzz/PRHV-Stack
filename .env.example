# Copy to .env and fill in real values
# cp .env.example .env

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lunite"

# Better Auth (generate with: bunx @better-auth/cli secret)
BETTER_AUTH_SECRET="change-me-to-a-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
# Extra origins allowed to call the auth API (comma-separated, e.g. dev on another port)
TRUSTED_ORIGINS=""

# Server port (Lunite default 4114)
PORT="4114"
