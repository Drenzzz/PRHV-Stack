# Copy to .env and fill in real values
# cp .env.example .env

# Google Analytics (optional)
PUBLIC_ENV__GOOGLE_ANALYTICS="G-XXXXXXXXXX"

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/my-app"

# Better Auth (generate with: bunx @better-auth/cli secret)
BETTER_AUTH_SECRET="change-me-to-a-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
# Extra origins allowed to call the auth API (comma-separated, e.g. dev on another port)
TRUSTED_ORIGINS=""

# GitHub OAuth (optional, enables "Sign in with GitHub" when both are set)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
