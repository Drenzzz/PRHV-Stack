# Copy to .env and fill in real values
# cp .env.example .env

# PostgreSQL connection string (host port 5436 → container 5432 via compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/lunite"

# Redis connection string (host port 5385 → container 6379 via compose)
REDIS_URL="redis://localhost:5385"

# Better Auth (generate with: bunx @better-auth/cli secret)
BETTER_AUTH_SECRET="change-me-to-a-random-secret"
BETTER_AUTH_URL="http://localhost:4114"
# Extra origins allowed to call the auth API (comma-separated, e.g. dev on another port)
TRUSTED_ORIGINS=""

# 32-byte random hex — encrypts stored Telegram tokens at rest (openssl rand -hex 32)
APP_ENCRYPTION_KEY=""

# Platform Telegram bot fallback sender (channel token wins if set) — treat as a secret
TELEGRAM_BOT_TOKEN=""

# Public URL of the deployment (status-page links, OG URLs)
PUBLIC_WEB_URL=""

# Server port (Lunite default 4114; compose publishes 4224:4114)
PORT="4114"

# Probe region tag written into checks rows
REGION="id-1"

# SSRF guard opt-out for local targets (default false)
ALLOW_PRIVATE_PROBE_TARGETS="false"

# Production enables Secure cookie flag
NODE_ENV=""
